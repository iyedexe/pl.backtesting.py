# Run one scan every weekday at 22:15 UTC - after the US close; the European
# markets closed hours earlier, so one daily scan covers all four indices.
# Adjust paths and the python binary to your machine.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
15 22 * * 1-5  cd /path/to/pl.backtesting.py/bot && python3 -m inclusion_bot scan >> inclusion_bot.log 2>&1
